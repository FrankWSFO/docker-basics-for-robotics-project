FROM osrf/ros:humble-desktop
# FROM frankwsfo/nvidia_ros2:latest

# Change the default shell to Bash
SHELL [ "/bin/bash" , "-c" ]

# Install Gazebo 11 and other dependencies
RUN apt-get update && apt-get install -y \
  ros-humble-rmw-cyclonedds-cpp \
  ros-humble-rosbridge-suite \
  ros-humble-web-video-server \
  python3-colcon-common-extensions \
  build-essential \
  git \
  && rm -rf /var/lib/apt/lists/*

COPY ./webpage_ws/webpage-ws-the-construct-web-development-project /webpage_ws/
RUN source /opt/ros/humble/setup.bash \
    && echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc

# Set environment variables
ENV ROS_DOMAIN_ID=1
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# ENV GAZEBO_MODEL_PATH=/fastbot_ws/src/fastbot/fastbot_description/models:/fastbot_ws/src:/fastbot_ws/src/fastbot:/fastbot_ws/src/fastbot/fastbot_description:/fastbot_ws/src/fastbot/fastbot_description/onshape:/fastbot_ws/src/fastbot/fastbot_description/onshape/assets:/fastbot_ws/src/fastbot/fastbot_description
# ENV GAZEBO_PLUGIN_PATH=/usr/lib/x86_64-linux-gnu/gazebo-11/plugins
# ENV GAZEBO_RESOURCE_PATH=/usr/share/gazebo-11:/usr/share/gazebo

# Set the working folder at startup
WORKDIR /webpage_ws/fastbot_webapp

ENTRYPOINT ["/bin/bash", "-c", "python3 -m http.server 7000 & source /opt/ros/humble/setup.bash && ros2 launch rosbridge_server rosbridge_websocket_launch.xml & source /opt/ros/humble/setup.bash && ros2 run web_video_server web_video_server --ros-args -p port:=11315 & tail -f /dev/null"]
# ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/humble/setup.bash && source /fastbot_ws/install/setup.bash && ros2 launch fastbot_gazebo one_fastbot_room.launch.py"]
# ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/humble/setup.bash && source /fastbot_ws/install/setup.bash && ros2 launch fastbot_gazebo one_fastbot_room.launch.py --log-level debug 2>&1 | grep -i "mesh\|stl\|package\|fastbot_description""]
