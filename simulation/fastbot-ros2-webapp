FROM osrf/ros:humble-desktop
# FROM frankwsfo/nvidia_ros2:latest

# Change the default shell to Bash
SHELL [ "/bin/bash" , "-c" ]

RUN apt-get update && apt-get install -y \
  ros-humble-rmw-cyclonedds-cpp \
  ros-humble-rosbridge-suite \
  ros-humble-web-video-server \
  python3-colcon-common-extensions \
  build-essential \
  git \
  && rm -rf /var/lib/apt/lists/*

COPY ./webpage_ws/webpage-ws-the-construct-web-development-project /webpage_ws/

RUN source /opt/ros/humble/setup.bash \
    && echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc

# Set environment variables
ENV ROS_DOMAIN_ID=1
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Set the working folder at startup
WORKDIR /webpage_ws/fastbot_webapp

ENTRYPOINT ["/bin/bash", "-c", "python3 -m http.server 7000 & source /opt/ros/humble/setup.bash && ros2 launch rosbridge_server rosbridge_websocket_launch.xml & source /opt/ros/humble/setup.bash && ros2 run web_video_server web_video_server --ros-args -p port:=11315 & tail -f /dev/null"]



