FROM osrf/ros:humble-desktop

# Change the default shell to Bash
SHELL [ "/bin/bash" , "-c" ]

RUN apt-get update && apt-get install -y \
  ros-humble-robot-state-publisher \
  ros-humble-robot-localization \
  ros-humble-xacro \
  ros-humble-tf2-ros \
  ros-humble-tf2-tools \
  ros-humble-cartographer \
  ros-humble-cartographer-ros \
  ros-humble-rviz2 \
  ros-humble-rviz-common \
  ros-humble-rviz-default-plugins \
  ros-humble-rmw-cyclonedds-cpp \
  python3-colcon-common-extensions \
  build-essential \
  git \
  && rm -rf /var/lib/apt/lists/*

# Create a Colcon workspace and clone Neobotix repos
RUN source /opt/ros/humble/setup.bash \
    && mkdir -p /fastbot_ws/src \
    && cd /fastbot_ws/src

COPY ./fastbot /fastbot_ws/src/fastbot/
COPY ./fastbot_ros2_docker/simulation/cartographer_config.rviz /fastbot_ws/src/fastbot/fastbot_slam/config/cartographer_config.rviz
 
# Build the Colcon workspace and ensure it's sourced
RUN source /opt/ros/humble/setup.bash \
    && cd /fastbot_ws \
    && colcon build \
    && source /fastbot_ws/install/setup.bash
RUN echo "source /opt/ros/humble/setup.bash && source /fastbot_ws/install/setup.bash" >> ~/.bashrc

# Set environment variables
ENV ROS_DOMAIN_ID=1
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Set the working folder at startup
WORKDIR /fastbot_ws

ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/humble/setup.bash && source /fastbot_ws/install/setup.bash && ros2 launch fastbot_slam cartographer.launch.py & sleep 5 && source /opt/ros/humble/setup.bash && rviz2 -d /fastbot_ws/src/fastbot/fastbot_slam/config/cartographer_config.rviz & tail -f /dev/null"]


