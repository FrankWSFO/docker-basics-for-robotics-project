FROM osrf/ros:humble-desktop

# Change the default shell to Bash
SHELL [ "/bin/bash" , "-c" ]

# Install Gazebo 11 and other dependencies
RUN apt-get update && apt-get install -y \
  ros-humble-gazebo-ros-pkgs \
  ros-humble-gazebo-ros2-control \
  ros-humble-ros2-control \
  ros-humble-ros2-controllers \
  ros-humble-joint-state-publisher \
  ros-humble-robot-state-publisher \
  ros-humble-robot-localization \
  ros-humble-xacro \
  ros-humble-tf2-ros \
  ros-humble-tf2-tools \
  ros-humble-ros2-control \
  ros-humble-ros2-controllers \
  ros-humble-rmw-cyclonedds-cpp \
  python3-colcon-common-extensions \
  build-essential \
  git \
  && rm -rf /var/lib/apt/lists/*

RUN source /opt/ros/humble/setup.bash \
    && mkdir -p /fastbot_ws/src \
    && cd /fastbot_ws/src

COPY ./fastbot /fastbot_ws/src/fastbot/
COPY ./fastbot_ros2_docker/simulation/modified_botbox_world_room.launch.xml /fastbot_ws/src/fastbot/fastbot_gazebo/launch/botbox_world_room.launch.xml
COPY ./fastbot_ros2_docker/simulation/modified_fastbot_description_package.xml /fastbot_ws/src/fastbot/fastbot_description/package.xml
COPY ./fastbot_ros2_docker/simulation/modified_one_fastbot_room.launch.py /fastbot_ws/src/fastbot/fastbot_gazebo/launch/one_fastbot_room.launch.py
COPY ./fastbot_ros2_docker/simulation/fastbot_description_model.config /fastbot_ws/src/fastbot/fastbot_description/model.config
 
# Build the Colcon workspace and ensure it's sourced
RUN source /opt/ros/humble/setup.bash \
    && cd /fastbot_ws \
    && colcon build \
    && source /fastbot_ws/install/setup.bash
RUN echo "source /opt/ros/humble/setup.bash && source /fastbot_ws/install/setup.bash" >> ~/.bashrc

# Set environment variables
ENV ROS_DOMAIN_ID=1
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Set the working folder at startup
WORKDIR /fastbot_ws

ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/humble/setup.bash && source /usr/share/gazebo/setup.sh && source /fastbot_ws/install/setup.bash && ros2 launch fastbot_gazebo one_fastbot_room.launch.py & tail -f /dev/null"]


