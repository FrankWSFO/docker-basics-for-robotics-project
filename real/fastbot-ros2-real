FROM ros:humble-ros-base
# FROM frankwsfo/nvidia_ros2:latest

# Change the default shell to Bash
SHELL [ "/bin/bash" , "-c" ]

# Install Gazebo 11 and other dependencies
RUN apt-get update && apt-get install -y \
  ros-humble-v4l2-camera ros-humble-image-transport-plugins v4l-utils \
  ros-humble-ros2-control \
  ros-humble-ros2-controllers \
  ros-humble-joint-state-publisher \
  ros-humble-robot-state-publisher \
  ros-humble-robot-localization \
  ros-humble-xacro \
  ros-humble-tf2-ros \
  ros-humble-tf2-tools \
  ros-humble-ros2-control \
  ros-humble-ros2-controllers \
  ros-humble-rmw-cyclonedds-cpp \
  libboost-thread-dev \
  libboost-system-dev \
  libpcl-dev \
  ros-humble-pcl-conversions \
  ros-humble-diagnostic-updater \
  python3-colcon-common-extensions \
  python3-serial \
  build-essential \
  git \
  && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y \
    libpcap-dev \
    && rm -rf /var/lib/apt/lists/*

RUN source /opt/ros/humble/setup.bash \
    && mkdir -p /fastbot_ws/src \                
        && cd /fastbot_ws/src \
    && git clone https://github.com/FrankWSFO/fastbot-ros2-drivers-checkpoint-20.git \
    && cd /fastbot_ws \
    && colcon build --symlink-install \
    && echo "source /opt/ros/humble/setup.bash && source /fastbot_ws/install/setup.bash" >> ~/.bashrc

# Set the working folder at startup
WORKDIR /fastbot_ws

ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/humble/setup.bash && source /fastbot_ws/install/setup.bash && ros2 launch fastbot_bringup bringup.launch.xml & tail -f /dev/null"]

